# Copia in .env.local per lo sviluppo. MAI committare file .env con valori reali.
# Validazione: src/lib/env.ts (l'app non parte se manca qualcosa).

NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=dev
LOG_LEVEL=debug

# Database (docker-compose.dev.yml)
DATABASE_URL=postgres://hr:hr_dev_only@localhost:5432/hr

# Chiavi (ADR-0004): file generati da `pnpm keys:generate` nella cartella ./secrets (ignorata da git).
# In produzione: Docker secrets in /run/secrets/…
KEK_FILE=./secrets/kek.b64
BLIND_INDEX_KEY_FILE=./secrets/blind-index.b64

# Email (Mailpit in locale; Brevo in produzione)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jobinetic <noreply@localhost>"

# Verifica P.IVA (VIES, Commissione europea). Se non risponde, l'azienda resta "in verifica".
VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# IP del visitatore (solo in memoria, per i limiti sui codici di accesso). Produzione: cf-connecting-ip
CLIENT_IP_HEADER=x-forwarded-for

# Feature flag (default sicuri: tutto spento) — src/lib/flags.ts
INTERMEDIATION_ENABLED=false
BILLING_ENABLED=false
ADSENSE_ENABLED=false
PREVIEW_MODE=false
FOUNDERS_PERIOD_UNTIL=2027-01-31T23:59:59+01:00

# Registro delle cancellazioni fuori dal DB (ADR-0014, WP-027). In produzione: file su un volume del server,
# incluso nei backup. In sviluppo si può lasciare vuoto.
# ERASURE_LEDGER_FILE=/var/lib/hr/cancellazioni.jsonl

# App Android (TWA, WP-010): pacchetto e impronte SHA-256 dei certificati (Play Console → Integrità dell'app),
# separate da virgole. Senza, /.well-known/assetlinks.json risponde 404. In sviluppo si lasciano vuote.
# ANDROID_PACKAGE_NAME=cloud.inspectio.jobinetic
# ANDROID_CERT_SHA256=AA:BB:…
