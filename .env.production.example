# Configurazione del server (WP-010c). Copia in .env.production sul server e completa. NIENTE password qui:
# le password e le chiavi stanno nella cartella ./secrets (docker-compose.prod.yml → Docker secrets).
# Validazione all'avvio: src/lib/env.ts (il sito non parte se manca qualcosa).

NODE_ENV=production
# Indirizzo pubblico (sottodominio con il nome dell'app, ADR-0012 §5; docs/09-DOMANDE-APERTE.md Q1).
APP_URL=https://jobinetic.inspectio.cloud
LOG_LEVEL=info

# Dietro Cloudflare Tunnel l'IP del visitatore arriva in questa intestazione (solo in memoria, per i limiti).
CLIENT_IP_HEADER=cf-connecting-ip

# Posta: Brevo (account gratuito, dominio autenticato con SPF/DKIM/DMARC). La password va in ./secrets/smtp_password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
MAIL_FROM="Jobinetic <noreply@inspectio.cloud>"

VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Feature flag (src/lib/flags.ts). Fino al 27/10/2026: anteprima con codice invito per i tester (WP-010b).
INTERMEDIATION_ENABLED=false
BILLING_ENABLED=false
ADSENSE_ENABLED=false
PREVIEW_MODE=true
# Codici invito separati da virgole: `pnpm preview:invite-code`. Cambiandolo si chiudono le nuove registrazioni.
PREVIEW_INVITE_CODES=
FOUNDERS_PERIOD_UNTIL=2027-01-31T23:59:59+01:00

# App Android (WP-010d): pacchetto e impronte SHA-256 da Play Console → Integrità dell'app. Tutte e due o nessuna.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# Backup fuori sede su Cloudflare R2 (10 GB gratis, ADR-0012 §7). Chiavi di accesso in ./secrets/r2_*.
RESTIC_REPOSITORY=s3:https://<ID-ACCOUNT>.r2.cloudflarestorage.com/<NOME-BUCKET>
