{
  "name": "hr-lavoro-locale",
  "version": "0.1.0",
  "private": true,
  "description": "Piattaforma senza scopo di lucro per il lavoro vicino a casa",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "geo:build": "tsx scripts/geo-build.ts",
    "geo:import": "tsx scripts/geo-import.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
